# PPMI Portal Credentials
# Register at https://www.ppmi-info.org to obtain these
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

PPMI_USER=your_registered_email@ppmi-info.org
PPMI_PASSWORD=your_ppmi_portal_password
PPMI_DATA_PATH=./data/raw
PPMI_MRI_PATH=./data/raw/mri
